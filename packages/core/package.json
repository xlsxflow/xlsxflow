{
  "name": "@xlsxflow/core",
  "version": "1.1.6",
  "description": "Streaming, zero-dependency .xlsx reader, writer and editor for Node, Bun, browsers and Cloudflare Workers",
  "license": "MIT",
  "author": "Omkar Palika",
  "homepage": "https://github.com/xlsxflow/xlsxflow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xlsxflow/xlsxflow.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/xlsxflow/xlsxflow/issues"
  },
  "type": "module",
  "keywords": [
    "xlsx",
    "xls",
    "ods",
    "excel",
    "spreadsheet",
    "streaming",
    "ooxml",
    "edge",
    "cloudflare-workers",
    "reader",
    "writer",
    "csv",
    "browser",
    "typescript"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.12"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.include=src --coverage.reporter=text --coverage.reporter=json-summary --testTimeout=60000",
    "prepack": "node -e \"require('fs').copyFileSync('../../README.md','README.md')\" && rollup -c"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "4.1.11",
    "fast-check": "4.10.2",
    "rollup": "^4.21.0",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
